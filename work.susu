work w_28a997c27e595dd0 target=project subject=- expectation=e_c370aa74e3d748dd kind=implementation status=completed source="human:maintainer" evidence=- title="Add HTML review thread filters" detail="Added portable portal controls for review-thread text search and owner/status filtering, with live result counts and workload ownership metrics.";
work w_bff7be76de664b17 target=project subject=- expectation=e_d2ea70fddeae3e96 kind=implementation status=completed source="human:maintainer" evidence=- title="Clarify static portal boundary" detail="Removed action-oriented language from the HTML-only review thread view and documented that mutations require a separate review service.";
work w_3a422566b82b8a5d target=project subject=- expectation=e_88f8b90833f3a00c kind=documentation status=completed source="human:maintainer" evidence=- title="Inventory current Susumu capabilities" detail="Documented current evidence, authored records, findings, review/readiness, Git, compliance posture, TUI, CLI, CI, JSON, portal, and shared-surface usage contracts.";
work w_84ee8167eff9b6d2 target=project subject=- expectation=e_8975f30ee4865f18 kind=documentation status=completed source="human:maintainer" evidence=- title="Define shared collaboration API contract" detail="Specified the shared JSON API resources and event model for the live frontend, engineering clients, and CI without creating a second evidence model.";
work w_a822fb11f9d5bc36 target=project subject=- expectation=e_fb67a766557d0f8d kind=documentation status=completed source="human:maintainer" evidence=- title="Define auditable repository collaboration lifecycle" detail="Specified local user roles, configured repository connections, server-side GitHub App access, and one-active-PR synchronization behavior.";
work w_8737f5e333702b17 target=project subject=- expectation=e_5cb64d62c94d45d1 kind=documentation status=completed source="human:maintainer" evidence=- title="Define collaboration compliance boundary" detail="Specified that authenticated actions, pull requests, merges, approvals, signatures, and attestations remain distinct from verification and compliance conclusions.";
work w_7ad13106af2c8fc3 target=project subject=- expectation=e_b1c5dd37a9811667 kind=infrastructure status=completed source="human:maintainer" evidence=- title="Build Dockerized API foundation" detail="Added the feature-gated susumu-server binary, modular src/server layout, PostgreSQL migrations, Argon2-backed bootstrap users, hashed sessions, health and auth endpoints, Dockerfile, Compose deployment, and deployment documentation.";
work w_cbc1ad9c0f3a05e8 target=project subject=- expectation=e_b1c5dd37a9811667 kind=implementation status=completed source="human:maintainer" evidence=- title="Keep qualified external calls out of cycle findings" detail="Updated call resolution to preserve qualified external method calls as external edges, preventing API library/database calls from becoming false recursive SUS005 findings.";
work wk_git_01155884299f7f34_ade6dc78 target=project subject=- expectation=e_b1c5dd37a9811667 kind=infrastructure status=completed source="human:git-link" evidence="commit:01155884299f7f34202a4705b6b17b566359c857" title="Dockerized API foundation" detail="Generated by git link.\nCommit: 01155884299f7f34202a4705b6b17b566359c857\nAuthor: Justin Werner <justin@speroleague.com>\nDate: 2026-07-24T17:28:19-05:00\nExpectation: e_b1c5dd37a9811667 - Dockerized API has a safe operational foundation\nChanged files:\n- .dockerignore\n- Cargo.lock\n- Cargo.toml\n- Dockerfile\n- README.md\n- docker-compose.yml\n- docs/deployment.md\n- expectations.susu\n- migrations/0001_initial.sql\n- src/bin/susumu-server.rs\n- src/language.rs\n- src/lib.rs\n- src/scanner.rs\n- src/server/auth.rs\n- src/server/config.rs\n- src/server/db.rs\n- src/server/error.rs\n- src/server/mod.rs\n- verifications.susu\n- work.susu\n\nNote:\nCommit adds the optional server binary, Postgres migrations, local sessions, Docker Compose deployment, and scanner regression guard.";
work w_6e3d2b1f9a7c40e2 target=project subject=- expectation=e_4f2d7a8c1b6e90d3 kind=infrastructure status=completed source="human:maintainer" evidence=- title="Register scoped repository connections" detail="Added the repository and per-base-branch sync-state migrations, authenticated project listing, administrator-only repository registration, and validation that allowlists GitHub repositories and repository-relative sidecar paths.";
work w_91c4e7a2d6f0b3e8 target=project subject=- expectation=e_7b1e4c9d2a6f83e0 kind=implementation status=completed source="human:maintainer" evidence=- title="Queue repository-scoped synchronization" detail="Added an authenticated sync endpoint, transactional per-repository/base-branch queue transitions, append-only audit events, and CSRF protection for cookie-authenticated mutations.";
work w_2f7a9c4e1b6d80a3 target=project subject=- expectation=e_3d8a1f6c4b9e20d7 kind=implementation status=completed source="human:maintainer" evidence=- title="Keep GitHub App credentials server-side" detail="Added optional server-side GitHub App configuration from an app id and PEM key file, a provider client boundary, startup validation, and a health-only configured boolean without exposing key material.";
work w_4a8d1c6e9f2b3075 target=project subject=- expectation=e_8c2f5a1d7b9e40f6 kind=implementation status=completed source="human:maintainer" evidence=- title="Inspect configured repository branches" detail="Added an admin-only GitHub inspection endpoint that validates the configured base branch, exchanges a server-side installation token, and returns only the configured repository identity and branch SHA.";
work w_5b9e2d7c1a6f3084 target=project subject=- expectation=e_fb67a766557d0f8d kind=implementation status=completed source="human:maintainer" evidence=- title="Add server-side GitHub write primitives" detail="Added worker-facing provider operations for creating a repository branch, upserting a materialized file, and creating or updating a pull request. These operations remain behind the API boundary and are not exposed as browser routes; lifecycle synchronization remains pending.";
work w_7c1e5a9d2b6f3084 target=project subject=- expectation=e_6d2f8a1c9b4e3075 kind=implementation status=completed source="human:maintainer" evidence=- title="Enforce one active repository PR lifecycle" detail="Added an atomic queued-to-syncing claim, a repository-scoped PostgreSQL uniqueness invariant across syncing and pending states, allowlisted sidecar materialization, active-PR reuse, merged-lifecycle reset behavior, and bounded authenticated API submission of UTF-8 Susumu changes.";
work w_8d2f6a1c9b4e3075 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Add authenticated workspace frontend" detail="Added a same-origin Nginx frontend with local-user login, repository switching, synchronization posture, admin repository registration, bounded sidecar submission, provider-credential separation, and a calm ivory/coral/sage Susumu visual system.";
work w_9e3a7c1d5b2f4086 target=project subject=- expectation=e_b1c5dd37a9811667 kind=documentation status=completed source="human:maintainer" evidence=- title="Make local Compose secrets safe to bootstrap" detail="Added an ignored .env and .env.* policy with an explicit committed .env.example template, documented the copy-and-replace workflow, and included local HTTP cookie and frontend port settings.";
work w_1a6e3c9d2b7f4085 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=infrastructure status=completed source="human:maintainer" evidence=- title="Make frontend Compose builds junction-safe" detail="Changed the frontend image to use a root-level Dockerfile.frontend and repository-root build context, avoiding Docker Desktop path evaluation failures when the workspace is reached through a Windows junction.";
work w_2b7f4d1a9e3c5086 target=project subject=- expectation=e_b1c5dd37a9811667 kind=infrastructure status=completed source="human:maintainer" evidence=- title="Gate frontend startup on API health" detail="Added curl to the API runtime image, an HTTP healthcheck against /healthz, and a frontend dependency on the healthy API so invalid API configuration reports at the API boundary instead of causing a misleading Nginx upstream DNS failure.";
work w_3c8a1e5d9b2f6074 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=infrastructure status=completed source="human:maintainer" evidence=- title="Use Caddy for the frontend edge" detail="Replaced the frontend's Nginx image with Caddy, retaining same-origin API proxying and SPA fallback while adding persistent certificate/configuration volumes and configurable HTTP/HTTPS ports for local and production deployment.";
work w_4d9b2f6a1c7e5083 target=project subject=- expectation=e_b1c5dd37a9811667 kind=implementation status=completed source="human:maintainer" evidence=- title="Treat blank optional GitHub settings as disabled" detail="Made whitespace-only GitHub App environment variables equivalent to unset values while preserving paired-configuration validation when one credential is supplied, so local Compose can run without GitHub configuration.";
work w_5e1c8a4d9b2f6073 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Keep authentication controls out of the login view" detail="Made hidden controls unconditionally non-rendering and initialized the frontend in signed-out state before session discovery, preventing a sign-out action from appearing on the login page.";
work w_6f2a9c4d1b7e5083 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Route frontend API mutations through Caddy" detail="Changed the Caddy edge to use explicit /api/* and /healthz handlers with a final static fallback, preventing login POST requests from falling through to the read-only file server.";
work w_7a3c9e1d5f2b6048 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Explain portable evidence in the workspace header" detail="Replaced the ambiguous green-dot message with an info icon, a plain-language portable .susu evidence label, and the surfaces that share those records.";
work w_8b4d1f6a9c2e5073 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Give the empty repository list breathing room" detail="Added a modest top inset above the empty repository message so the Connections heading and its empty state read as separate layers while retaining their shared left edge.";
work w_9c5e2a7d1f4b6083 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Keep evidence context near the workspace content" detail="Constrained and inset the portable evidence note on desktop so its explanatory copy does not drift to the far edge, while preserving natural full-width behavior on smaller screens.";
work w_ad6f2c9e1b4d5073 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Add skippable first-repository onboarding" detail="Added a first-run administrator wizard with three steps, reversible skip behavior, clear deployment capability messaging, GitHub setup, installed repository discovery, and guided repository defaults without exposing installation IDs to normal users.";
work w_be7a3d1f5c9b6048 target=project subject=- expectation=e_3d8a1f6c4b9e20d7 kind=implementation status=completed source="human:maintainer" evidence=- title="Encrypt GitHub App credentials in PostgreSQL" detail="Added a deployment-scoped encryption key, AES-256-GCM encryption, a credential migration, authenticated administrator setup, runtime provider refresh, and retained server-side environment configuration compatibility. PEM plaintext is not stored in the database or returned to the browser.";
work w_cf8b4e2a6d1f5073 target=project subject=- expectation=e_8975f30ee4865f18 kind=implementation status=completed source="human:maintainer" evidence=- title="Discover installed repositories through the shared API" detail="Added an administrator-only GitHub App discovery endpoint that lists installed repositories and feeds the same repository registration model used by the frontend, CLI, and future engineering clients.";
work w_d9a5c1e7b3f6048 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Explain GitHub App setup inside onboarding" detail="Added an accessible info button to step one that explains creating the private App, installing it on allowed repositories, required repository permissions, and server-side encrypted key handling.";
work w_e1b7d3f5a9c60482 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Keep onboarding form references after requests" detail="Captured submitted form elements before asynchronous API calls so successful GitHub App and manual repository setup can reset and continue without relying on a cleared event currentTarget.";
work w_f2c8a4d6b1e50793 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Use the full onboarding card width" detail="Removed narrow desktop max-width constraints from onboarding messages and forms so the GitHub App explanation, inputs, and private key field share the full card width.";
work w_a3e7c1d5f9b60482 target=project subject=- expectation=e_8975f30ee4865f18 kind=implementation status=completed source="human:maintainer" evidence=- title="Present repository memory by evidence area" detail="Added a repository-scoped GitHub inspection path that reads only configured Susumu sidecars from the selected base branch and presents their presence and current content to authenticated frontend users without exposing provider credentials.";
work w_b4f8d2e6a1c50793 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Replace raw sidecar editing with branded record cards" detail="Collapsed the duplicate evidence and change selectors into one Project memory card, removed raw sidecar text from the business-facing view, and rendered readable authored record summaries by purpose.";
work w_c5a9e3f7b2d60481 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Space evidence area controls from records" detail="Added clear separation below the Expectations and Verifications evidence buttons so the purpose selectors do not run into the record summaries beneath them.";
work w_d6b0f4a8c3e91572 target=project subject=- expectation=e_6f3a9c1d7b5e2048 kind=implementation status=completed source="human:maintainer" evidence=- title="Add structured project memory forms" detail="Replaced the hidden raw sidecar editor with guided forms for expectations, verifications, work records, and review comments, preserving bounded sidecar synchronization and portable record syntax.";
work w_e7c1a9d5b3f60482 target=project subject=- expectation=e_7a4c1e9d5b2f3086 kind=implementation status=completed source="human:maintainer" evidence=- title="Restore sessions and add evidence drill-down" detail="Extended authenticated session persistence, added a refresh-safe workspace bootstrap, normalized evidence record parsing, and added fuzzy search, record detail, timeline, source context, and next-work navigation.";
work w_f8d2b6a4c1e50793 target=project subject=- expectation=e_8b5d2f1a7c9e4063 kind=implementation status=completed source="human:maintainer" evidence=- title="Separate authentication and workspace failures" detail="Changed frontend startup so only an /api/me failure signs out the user; repository-list and rendering failures now preserve the active session and show an actionable workspace error.";
work w_a9e3c7b1d5f60482 target=project subject=- expectation=e_8b5d2f1a7c9e4063 kind=implementation status=completed source="human:maintainer" evidence=- title="Fix authoring tab collection handling" detail="Replaced single-element helper calls to forEach with explicit tab collections so the authenticated workspace can finish rendering its project memory card.";
work w_b0f4d8a2c6e91573 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Polish project memory controls" detail="Branded the dropdown controls, tightened Project memory card edge rendering, clarified fuzzy search behavior, and removed unnecessary repository-save helper copy from structured forms.";
work w_c1a5e9d3b7f60482 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:maintainer" evidence=- title="Prioritize actionable next work" detail="Moved Next work above Project memory, added recommendations from missing verification, unlinked work, failed checks, and open review threads, and aligned the detail timeline with its connecting line.";
work w_d7e3a1c9b5f60482 target=project subject=- expectation=e_4f8b2c1d6a9e3075 kind=implementation status=completed source="human:maintainer" evidence=- title="Show anchored review conversations" detail="Added explicit portable review anchors, preserved parent replies across the CLI and TUI, and rendered anchored thread browsing, reply, and new-thread actions from live portal record details.";
work w_e8f4b2c1d6a9e3075 target=project subject=- expectation=e_5a9c3f7b1d60482 kind=implementation status=completed source="human:maintainer" evidence=- title="Index project memory for API search" detail="Added a Postgres search index for parsed record summaries, ranked fuzzy API queries with scope filters and pagination, changed-sidecar upserts, and a periodic repository refresh loop.";
work w_7c3e9a5b1d60482 target=project subject=- expectation=e_6b2d8f4a1c90735e kind=implementation status=in_progress source="human:owner" evidence=- title="Persist synchronization provenance and conflict state" detail="Store base and head SHAs, detect base advancement, and expose explicit active-PR update behavior.";
work w_9e5a2c7d1b60483f target=project subject=- expectation=e_6b2d8f4a1c90735e kind=verification status=completed source="human:owner" evidence=- title="Add a local GitHub conflict scenario" detail="Exercise expected-head updates and rejected pull-request updates against a local GitHub-compatible HTTP fixture.";
work w_b7d4e1f9c20358a6 target=project subject=- expectation=e_6b2d8f4a1c90735e kind=infrastructure status=completed source="human:owner" evidence=- title="Expose the conflict scenario in Docker" detail="Provide an opt-in fake GitHub service, seeded repository connection, and visible conflict state for portal walkthroughs.";
work w_d9f6b3a1e2c74850 target=project subject=- expectation=e_6b2d8f4a1c90735e kind=implementation status=completed source="human:owner" evidence=- title="Add guided in-Susumu conflict resolution" detail="Added a structured conflict API and branded portal resolver that combines distinct records from both sides, requires explicit choices for same-ID changes, and writes the selected result through the active pull request without changing the base branch.";
work w_e1a7c4d2b9f60853 target=project subject=- expectation=e_6b2d8f4a1c90735e kind=implementation status=completed source="human:owner" evidence=- title="Lock conflicted repositories" detail="Paused portal authoring and rejected API queue requests while a repository conflict remains unresolved, while clearing stale evidence and reloading all configured data when users switch connections.";
work w_f2b8d4e1a7c60954 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:owner" evidence=- title="Clarify conflict and repository scan states" detail="Improved the conflict resolver hierarchy, explained automatic inclusion of unique records, moved actions below the policy message, tightened Project memory spacing, and translated provider scan failures into actionable connection guidance.";
work w_c7e2a1f9b4d60835 target=project subject=- expectation=e_4f2d7a8c1b6e90d3 kind=implementation status=completed source="human:owner" evidence=- title="Reuse GitHub connections across repositories" detail="Repository registration now discovers repositories through the configured GitHub App, excludes repositories already connected, uses all supported Susumu sidecars by default, and removes the local Docker conflict fixture from the deployment path.";
work w_d8f3a2b1c7e60495 target=project subject=- expectation=e_4f2d7a8c1b6e90d3 kind=implementation status=completed source="human:owner" evidence=- title="Support multiple GitHub connections and branch selection" detail="Added encrypted multi-connection storage with migration of the existing App, scoped repository discovery and branch loading, connection-aware repository synchronization, and portal controls for adding or reusing a GitHub App connection.";
work w_e9a4b3c2d8f60716 target=project subject=- expectation=e_9a4c1e7d2b6f3085 kind=implementation status=completed source="human:owner" evidence=- title="Harden connection dialog and Project memory rendering" detail="Made new-connection cancellation and close controls non-submitting buttons and restored Project memory to the shared card surface styling so Firefox renders its corners consistently with the other cards.";
work w_f1a2c3d4e5b60718 target=project subject=- expectation=e_88f8b90833f3a00c kind=documentation status=completed source="human:owner" evidence=- title="Refresh product documentation" detail="Updated the README, deployment guide, collaboration backend guide, and feature inventory to describe the current CLI, TUI, static portal, live portal, API, CI, multiple GitHub connections, branch selection, structured authoring, API search, per-repository PR lifecycle, conflict resolution, and compliance boundaries.";
work w_7c3d9a1f5b2e4087 target=project subject=- expectation=e_7c3d9a1f5b2e4087 kind=documentation status=completed source="human:owner" evidence=- title="Document local testing and deployment" detail="Added platform-neutral Docker Compose instructions for local testing, health checks, shutdown, persistent local state, and deployment ownership across Linux, macOS, and Windows-compatible container infrastructure.";
work w_3e9a1c7d5b2f4086 target=project subject=- expectation=e_88f8b90833f3a00c kind=documentation status=completed source="human:owner" evidence=- title="Make documentation approachable" detail="Reviewed the README and documentation set for new-user onboarding, platform assumptions, stale capability claims, and product boundaries. Added role-based starting points, a documentation map, a current-status table, and platform-neutral command examples.";
