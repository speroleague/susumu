# Local-only Docker Compose settings. Copy to .env and replace the passwords.
POSTGRES_PASSWORD=replace-with-a-long-local-database-password
SUSUMU_ADMIN_EMAIL=admin@example.com
SUSUMU_ADMIN_PASSWORD=replace-with-a-long-local-admin-password
SUSUMU_COOKIE_SECURE=false
SUSUMU_FRONTEND_PORT=3000
SUSUMU_FRONTEND_HTTPS_PORT=3443
SUSUMU_FRONTEND_HOST=:80
SUSUMU_CREDENTIAL_KEY=replace-with-base64-32-byte-deployment-key

# Optional GitHub App configuration. Keep the private key outside the repository.
SUSUMU_GITHUB_APP_ID=
SUSUMU_GITHUB_APP_PRIVATE_KEY_FILE=
