expectation e_checkout_sequence target=workflow subject=w_d130b2169301b204 status=accepted source="human:product" title="Checkout reserves inventory before charging" detail="The checkout workflow must reserve inventory before payment capture, then notify the customer and write an audit event.";
expectation e_orders_read_only target=workflow subject=w_b0d08cef07a3ac4f status=proposed source="human:support" title="Orders list stays read-only" detail="The orders list workflow should only load order information and must not mutate order state.";
expectation e_user_creation_event target=workflow subject=w_32b93a08ebb09692 status=accepted source="human:operations" title="User creation publishes an operational event" detail="Creating a user should save the user and publish a user-created event so downstream teams can reconcile access changes.";
