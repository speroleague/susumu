verification v_3fd4f0c06a0417e8 expectation=e_susumu_provenance_tiers_are_not_compliance_claims status=passed method="manual documentation review; cargo test --locked; cargo clippy --all-targets --locked -- -D warnings" source="human:maintainer" evidence="local:provenance-tier-contract" basis=- detail="The provenance documentation separates declared, content-bound, externally authenticated, and human-reviewed evidence, rejects vendor-name trust, and explicitly prohibits compliance conclusions in Susumu output.";
